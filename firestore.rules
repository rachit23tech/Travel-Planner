rules_version = '2';

// Each signed-in user gets exactly one document under /users, holding
// their Home/Work shortcuts and recent searches (see
// lib/services/saved_places_service.dart). Nobody can read or write
// another user's document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Backs both "share my live location" (a public, one-way link -
    // see public/live.html) and "convoy" (a group of signed-in Iter
    // users navigating to the same place, seeing each other live).
    // Solo shares mark themselves public so the unauthenticated web
    // viewer can read them; convoy shares stay gated on being signed
    // in - the random 6-character join code is the actual invite, the
    // same trust model as any "anyone with the link" share.
    match /shares/{shareId} {
      allow get: if resource.data.public == true || request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid
                    && request.auth.uid in request.resource.data.memberUids;
      // A join (adding yourself to memberUids) or a position update
      // (already a member) - either way the caller must end up being,
      // or already be, one of the members.
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.memberUids
                        || request.auth.uid in request.resource.data.memberUids);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
  }
}
